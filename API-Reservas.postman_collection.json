  "item": [
    {
      "name": "Preparacion",
      "item": [
        {
          "name": "Obtener Sucursales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sucursales",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sucursales"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fecha futura aleatoria (30 a 360 dias) para no chocar con reservas de corridas anteriores",
                  "const d = new Date(Date.now() + (30 + Math.floor(Math.random() * 330)) * 24 * 3600 * 1000);",
                  "const p = n => String(n).padStart(2, '0');",
                  "const dia = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());",
                  "pm.collectionVariables.set('fechaInicio', dia + 'T19:00:00-06:00');",
                  "pm.collectionVariables.set('fechaFin', dia + 'T21:00:00-06:00');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfiles-clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "perfiles-clientes"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const c = pm.response.json();",
                  "pm.test('Hay al menos un cliente', () => pm.expect(c).to.be.an('array').that.is.not.empty);",
                  "pm.collectionVariables.set('idCliente', c[0].idCuenta);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener mesas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mesas"
              ]
            },
            "description": "Elige la primera mesa con capacidad >= 2 y toma su sucursal, para que mesa y sucursal sean consistentes."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const mesa = pm.response.json().find(m => m.capacidad >= 2);",
                  "pm.test('Existe una mesa con capacidad >= 2', () => pm.expect(mesa).to.exist);",
                  "pm.collectionVariables.set('idMesa', mesa.idMesa);",
                  "pm.collectionVariables.set('idSucursal', mesa.idSucursal);"
                ]
              }
            }
          ]
        }
      ]
    },
