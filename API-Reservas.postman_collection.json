      "name": "Manejo de errores",
      "description": "Errores centralizados en GlobalExceptionHandler: 400 y 404 con el mismo formato ApiError.",
      "item": [
        {
          "name": "400 - Validación del DTO (capacidad 0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "mesas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idSucursal\": \"{{idSucursal}}\",\n  \"numero\": 99,\n  \"capacidad\": 0,\n  \"ubicacion\": \"Terraza\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Formato de error consistente', () => pm.expect(pm.response.json()).to.have.keys('timestamp','status','error','message','details'));",
                  "pm.test('Indica el campo inválido', () => pm.expect(pm.response.json().details.join(' ')).to.include('capacidad'));"
