          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Sigue CONFIRMADA', () => pm.expect(pm.response.json().estadoReserva).to.eql('CONFIRMADA'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7- Eliminar reserva",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/reservas/{{idReserva}}",
          "host": [
